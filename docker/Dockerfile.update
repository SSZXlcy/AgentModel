# Code-only rebuild on top of the last full image (same base, NumPy, PyYAML and SDK layers); needs no network.
# A full rebuild from scratch uses docker/Dockerfile.
#   docker build -f docker/Dockerfile.update --build-arg BASE=zhixun-harness:1.0 -t zhixun-harness:1.1 .
ARG BASE=zhixun-harness:1.0
FROM ${BASE}
USER root
RUN rm -rf /usr/local/lib/python3.12/site-packages/agent_harness
COPY src/agent_harness /usr/local/lib/python3.12/site-packages/agent_harness
COPY vendor /opt/agent-harness/vendor
COPY submission/contest_submission.py /app/contest_submission.py
COPY submission/model_config.txt /app/model_config.txt
WORKDIR /app
USER 65534:65534
ENTRYPOINT ["python3", "/app/harness.py"]
